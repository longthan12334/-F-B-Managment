# =============================================================================
#  RestoManager — .env cho VPS sau Cloudflare (chép thành /opt/restomanager/.env)
# -----------------------------------------------------------------------------
#      cp env.example .env && chmod 600 .env && nano .env
#      ./scripts/check-env.sh        # kiểm tra trước khi chạy
#
#  Mọi giá trị dạng <...> PHẢI thay. scripts/check-env.sh và chính backend sẽ
#  từ chối chạy nếu còn giá trị mẫu, secret ngắn hoặc trùng nhau.
#  Sinh chuỗi ngẫu nhiên:   openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
# =============================================================================

# ─── Tên miền (đã trỏ về Cloudflare, bản ghi A bật đám mây cam) ──────────────
DOMAIN=<ten-cua-ban>.id.vn
ALLOWED_ORIGINS=https://<ten-cua-ban>.id.vn
TZ_NAME=Asia/Ho_Chi_Minh

# ─── PostgreSQL (chạy trong Docker, không mở ra ngoài) ───────────────────────
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=<chuoi-ngau-nhien-it-nhat-24-ky-tu>
DB_POOL_MAX=10

# ─── Xác thực: BA chuỗi khác nhau, mỗi chuỗi >= 32 ký tự ─────────────────────
JWT_SECRET=<chuoi-ngau-nhien-1>
JWT_EXPIRES=15m
REFRESH_SECRET=<chuoi-ngau-nhien-2>
REFRESH_EXPIRES=30d
GUEST_SECRET=<chuoi-ngau-nhien-3>

# ─── Ảnh món ăn: Cloudflare R2 ───────────────────────────────────────────────
# Lấy ở Cloudflare → R2 → Manage R2 API Tokens → Create API token
#   (quyền "Object Read & Write", chỉ áp cho bucket ảnh).
STORAGE_DRIVER=r2
S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
S3_PORT=443
S3_USE_SSL=true
S3_REGION=auto
S3_BUCKET=<ten-bucket-anh>
S3_ACCESS_KEY=<access-key-id-cua-token-r2>
S3_SECRET_KEY=<secret-access-key-cua-token-r2>
# Custom domain đã gắn vào bucket (R2 → bucket → Settings → Custom Domains)
S3_PUBLIC_URL=https://img.<ten-cua-ban>.id.vn
S3_SIGNED_URLS=false
MAX_UPLOAD_BYTES=5242880

# ─── Khách quét QR ───────────────────────────────────────────────────────────
GUEST_SESSION_TTL_HOURS=6
GUEST_REQUIRE_CONFIRMATION=true
GUEST_MAX_LINES=30
GUEST_MAX_QTY=50

# ─── Nghiệp vụ & giới hạn ────────────────────────────────────────────────────
DEFAULT_VAT_RATE=8
MIN_PASSWORD_LENGTH=10
RL_AUTH_MAX=10
RL_API_MAX=600
RL_PUBLIC_MAX=30

# ─── Tài khoản khởi tạo ──────────────────────────────────────────────────────
# Lần chạy ĐẦU TIÊN: để true + mật khẩu mạnh → tạo admin/cashier/waiter.
# Đăng nhập, đổi mật khẩu từng tài khoản, rồi đặt lại false và chạy
#   ./scripts/dc.sh up -d backend
SEED_ON_BOOT=true
SEED_PASSWORD=<mat-khau-tam-it-nhat-12-ky-tu>

# ─── Caddy ───────────────────────────────────────────────────────────────────
# origin_tls     : chỉ chứng chỉ Origin CA (mặc định)
# origin_tls_aop : + Authenticated Origin Pulls (cần certs/cloudflare-origin-pull-ca.pem)
CADDY_TLS=origin_tls
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ─── Sao lưu ─────────────────────────────────────────────────────────────────
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
# Tuỳ chọn: đẩy bản sao lưu lên một bucket R2 KHÁC (profile "offsite").
# Dùng token R2 riêng, chỉ có quyền trên bucket sao lưu.
BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
