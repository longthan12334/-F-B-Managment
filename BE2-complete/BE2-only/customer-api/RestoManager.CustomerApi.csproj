<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RestoManager.CustomerApi</RootNamespace>
    <AssemblyName>RestoManager.CustomerApi</AssemblyName>
  </PropertyGroup>

  <!--
    Scope ~10 endpoint, team 3 người → KHÔNG tách 4 project.
    Vẫn giữ tinh thần Clean Architecture bằng cách chia FOLDER theo trách nhiệm:
      Models/       = Domain (entity + logic nghiệp vụ, không depend EF Core)
      Services/     = Application (use case)
      Data/         = Infrastructure (EF Core DbContext)
      Controllers/  = Presentation
      Dtos/         = DTO request/response
      Security/     = Middleware + action filter

    Khi dự án lớn lên có thể tách project — code đã sẵn phân chia theo folder.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>
