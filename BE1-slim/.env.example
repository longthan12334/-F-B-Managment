# =============================================================================
#  Environment variables mẫu cho RestoManager
#  Copy file này thành .env (KHÔNG commit) rồi điền giá trị thật.
#  Docker Compose đọc .env tự động.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_HOST=5432

# ─── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=restaurant
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=http://localhost:9000

# ─── Node.js backend (staff) ─────────────────────────────────────────────────
JWT_SECRET=please-change-me-in-prod
JWT_EXPIRES=15m
REFRESH_SECRET=please-change-me-too-in-prod
REFRESH_EXPIRES=30d
BACKEND_PORT_HOST=3000

# ─── Customer API (.NET) ─────────────────────────────────────────────────────
CUSTOMER_API_ENV=Development
CUSTOMER_API_PORT_HOST=5000
CUSTOMER_CORS_ORIGIN=http://localhost:8080
CUSTOMER_CORS_ORIGIN_STAGING=https://staging-order.restomanager.com

# ─── Frontend (staff web) ────────────────────────────────────────────────────
FRONTEND_PORT_HOST=8080

# ─── Customer Web (FE-1) ────────────────────────────────────────────────────
CUSTOMER_WEB_PORT_HOST=8081
