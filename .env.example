# =============================================================================
#  RestoManager — Cấu hình triển khai
# -----------------------------------------------------------------------------
#  Sao chép thành `.env` rồi chỉnh sửa:   cp .env.example .env
#
#  ❗ BẮT BUỘC trước khi chạy production — backend sẽ TỪ CHỐI KHỞI ĐỘNG nếu
#     thiếu hoặc còn dùng giá trị mẫu (xem src/shared/config.js):
#       1. Sinh 3 secret ngẫu nhiên, KHÁC NHAU:
#            openssl rand -base64 48
#       2. Đặt ALLOWED_ORIGINS theo tên miền thật
#       3. Đổi DB_PASSWORD và thông tin đăng nhập MinIO
#       4. NODE_ENV=production
# =============================================================================

NODE_ENV=development
APP_VERSION=3.0.0
TZ_NAME=Asia/Ho_Chi_Minh

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_HOST=5432
DB_POOL_MAX=10

# ─── Xác thực ────────────────────────────────────────────────────────────────
# Ba secret PHẢI KHÁC NHAU, mỗi cái ≥ 32 ký tự.
#   JWT_SECRET      ký access token của nhân viên (sống ngắn)
#   REFRESH_SECRET  ký refresh token (sống dài, thu hồi được)
#   GUEST_SECRET    ký token phiên của khách quét mã QR
JWT_SECRET=doi-gia-tri-nay-bang-openssl-rand-base64-48-nhe-0001
JWT_EXPIRES=15m
REFRESH_SECRET=doi-gia-tri-nay-bang-mot-chuoi-ngau-nhien-khac-0002
REFRESH_EXPIRES=30d
GUEST_SECRET=doi-gia-tri-nay-bang-mot-chuoi-ngau-nhien-khac-0003

# ─── CORS ────────────────────────────────────────────────────────────────────
# Danh sách domain được phép gọi API & WebSocket, cách nhau bằng dấu phẩy.
# BẮT BUỘC ở production. Ví dụ: https://pos.nhahang.vn,https://nhahang.vn
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ─── Kho đối tượng (ảnh món ăn) ──────────────────────────────────────────────
# STORAGE_DRIVER chọn một trong ba:
#
#   minio  → MinIO tự host trong Docker Compose (mặc định, không tốn phí)
#   s3     → Amazon S3
#   r2     → Cloudflare R2 (miễn phí băng thông đi ra — hợp khi dùng Cloudflare)
#
# Xem mục "Chuyển sang Cloudflare R2" trong DEPLOYMENT.md để biết giá trị cụ thể.
STORAGE_DRIVER=minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=restaurant
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_URL=http://localhost:9001

S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
# URL công khai để trình duyệt tải ảnh. Khi deploy thật, trỏ về domain của bạn:
#   https://cdn.nhahang.vn
S3_PUBLIC_URL=http://localhost:9000
# true khi bucket riêng tư (R2/S3 production) → backend phát URL ký có hạn
S3_SIGNED_URLS=false
MAX_UPLOAD_BYTES=5242880

# ─── Khách quét mã QR ────────────────────────────────────────────────────────
# Thời gian sống của phiên khách (giờ). Mã QR dán cố định trên bàn nên phiên
# phải tự hết hạn, nếu không người đi ngang quét một lần có thể gọi món mãi.
GUEST_SESSION_TTL_HOURS=6
# true  = món khách gọi phải được nhân viên duyệt mới vào đơn (khuyến nghị)
# false = tự động duyệt, dành cho mô hình tự phục vụ
GUEST_REQUIRE_CONFIRMATION=true
GUEST_MAX_LINES=30
GUEST_MAX_QTY=50

# ─── Giới hạn tần suất ───────────────────────────────────────────────────────
RL_AUTH_MAX=10
RL_API_MAX=200
RL_PUBLIC_MAX=30

# ─── Nghiệp vụ ───────────────────────────────────────────────────────────────
DEFAULT_VAT_RATE=8
MIN_PASSWORD_LENGTH=6

# ─── Dữ liệu mẫu ─────────────────────────────────────────────────────────────
# true  = tạo 3 tài khoản mẫu + thực đơn mẫu khi CSDL còn trống
# false = BẮT BUỘC ở production sau lần khởi tạo đầu tiên
SEED_ON_BOOT=true
SEED_PASSWORD=123

# ─── Cổng dịch vụ (máy chủ) ──────────────────────────────────────────────────
BACKEND_PORT_HOST=3000
FRONTEND_PORT_HOST=8080

# ─── Chỉ dùng cho docker-compose.prod.yml ────────────────────────────────────
# Tên miền chính, Caddy sẽ tự xin chứng chỉ TLS cho domain này
DOMAIN=nhahang.example.com
# Email nhận cảnh báo hết hạn chứng chỉ từ Let's Encrypt
ACME_EMAIL=admin@example.com
# Token của Cloudflare Tunnel (tuỳ chọn — xem DEPLOYMENT.md mục 4B)
CLOUDFLARE_TUNNEL_TOKEN=
